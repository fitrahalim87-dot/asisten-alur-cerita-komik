rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "pasukangaming@gmail.com";
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.keys().size() == 5
        && data.uid is string
        && data.uid == request.auth.uid
        && data.email is string
        && (data.email == request.auth.token.email || data.email == "")
        && data.displayName is string
        && data.photoURL is string;
    }

    function isValidLicense(data) {
      return data.keys().hasAll(['licenseId', 'licenseKey', 'userId', 'email', 'status', 'createdAt'])
        && (data.keys().size() == 6 || data.keys().size() == 7)
        && data.licenseId is string
        && data.licenseKey is string
        && data.userId is string
        && data.email is string
        && data.status is string
        && data.status in ['active', 'inactive'];
    }

    match /test-connection-doc/{docId} {
      allow read: if true;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create, update: if isSignedIn() && isOwner(userId) && isValidUser(incoming());
    }

    match /licenses/{licenseId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'inactive');
      allow update: if isSignedIn() && (
        isAdmin() || 
        (incoming().userId == request.auth.uid && (existing().userId == "" || existing().userId == request.auth.uid))
      );
      allow delete: if isAdmin();
    }
  }
}
